class Solution {
    public int countBattleships(char[][] board) {
        int count = 0;
        int m = board.length;
        int n = board[0].length;

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(board[i][j]=='X'){
                    int xCount = 0;
                    if(i+1<m && board[i+1][j]=='X') xCount++;
                    if(j+1<n && board[i][j+1]=='X') xCount++;

                    if(xCount==0) count++;
                }
            }
        }
        return count;
    }
}