class Solution {

    int n;

    void BFS(int start, List<List<Integer>> adj, List<List<Integer>> ans){
        Queue<Integer> q = new LinkedList<>();
        boolean[] visited = new boolean[n];
        q.offer(start);
        visited[start]=true;
        while(!q.isEmpty()){
            int node = q.poll();

            for(int i : adj.get(node)){
                if(!visited[i]){
                    q.offer(i);
                    visited[i]=true;
                    ans.get(i).add(start);
                }
            }
        }

    }

    public List<List<Integer>> getAncestors(int n, int[][] edges) {

        this.n=n;

        List<List<Integer>> ans = new ArrayList<>();
        for(int i=0; i<n; i++){
            ans.add(new ArrayList<>());
        }


        List<List<Integer>> adj = new ArrayList<>();
        for(int i=0; i<n; i++) adj.add(new ArrayList<>());

        for(int[] i : edges){
            int u = i[0];
            int v = i[1];

            adj.get(u).add(v);
        }

        for(int i=0; i<n; i++){
            BFS(i, adj, ans);
        }



        return ans;
    }
}