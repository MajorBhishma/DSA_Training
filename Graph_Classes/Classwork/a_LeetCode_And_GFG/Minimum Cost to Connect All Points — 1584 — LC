class Solution {
    public int minCostConnectPoints(int[][] points) {
        int n = points.length;
        List<List<int[]>> adj = new ArrayList<>();
        for(int i=0; i<n; i++) adj.add(new ArrayList<>());

        Queue<int[]> q = new PriorityQueue<>((a,b) -> Integer.compare(a[1], b[1]));
        boolean[] visited = new boolean[n];
        visited[0] = true;

        for(int i=0; i<n-1; i++){
            int[] u = points[i];

            for(int j=i+1; j<n; j++){
                int[] v = points[j];

                int dist = Math.abs(u[0]-v[0]) + Math.abs(u[1]-v[1]);
                adj.get(i).add(new int[] {j, dist});
                adj.get(j).add(new int[] {i, dist});

                if(i==0){
                    q.offer(new int[] {j, dist});
                }
            }
        }

        int cost = 0;
        int count = 1;

        while(!q.isEmpty()){
            int[] node = q.poll();
            int u = node[0];

            if(visited[u]) continue;
            visited[u]=true;
            cost += node[1];
            count++;
            if(count==n) return cost;

            for(int[] i : adj.get(u)){
                int v = i[0];
                int d = i[1];

                if(!visited[v]){
                    q.offer(new int[] {v,d});
                }
            }
        }

        return cost;

    }
}