class Solution {
    public int numEnclaves(int[][] grid) {
        int ans=0;
        int m = grid.length;
        int n = grid[0].length;

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(grid[i][j]==1){
                    ans+=BFS(grid, i, j, m, n);
                }
            }
        }

        return ans;
    }

    int BFS(int[][] grid, int i, int j, int m, int n){
        int[] dx = {0,0,-1,1};
        int[] dy = {-1,1,0,0};
        int count = 0;
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[]{i,j});
        grid[i][j]=0;
        boolean isEdge = false;

        while(!q.isEmpty()){
            int[] node = q.poll();
            count++;
            int x = node[0];
            int y = node[1];
            if(!isEdge && (x==0 || x==m-1 || y==0 || y==n-1)) isEdge=true;
            for(int k=0; k<4; k++){
                int nx = x + dx[k];
                int ny = y + dy[k];
                if(nx>=0 && nx<m && ny>=0 && ny<n && grid[nx][ny]==1){
                    q.offer(new int[]{nx,ny});
                    grid[nx][ny]=0;
                }
            }
        }
        return isEdge ? 0 : count;
    }

}