class Solution {
    public int orangesRotting(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int freshCount=0;
        Queue<int[]> q = new LinkedList<>();
        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(grid[i][j]==1){
                    freshCount++;
                }
                else if(grid[i][j]==2){
                    q.add(new int[] {i,j});
                }
            }
        }

        return BFS(grid, q, freshCount, m, n);
    }

    int BFS(int[][] grid, Queue<int[]> q, int freshCount, int m, int n){
        int time = 0;
        int[] dx = {0,0,-1,1};
        int[] dy = {-1,1,0,0};

        while(!q.isEmpty()){
            int size = q.size();
            boolean isRot = false;
            for(int i=0; i<size; i++){
                int[] node = q.poll();
                int x=node[0];
                int y=node[1];
                for(int j=0; j<4; j++){
                    int nx = x + dx[j];
                    int ny = y + dy[j];
                    if(nx>=0 && nx<m && ny>=0 && ny<n && grid[nx][ny]==1){
                        q.offer(new int[] {nx,ny});
                        grid[nx][ny]=2;
                        freshCount--;
                        isRot=true;
                    }
                }
            }
            if(isRot) time++;
            else break;
        }
        return freshCount==0 ? time : -1;
    }
}