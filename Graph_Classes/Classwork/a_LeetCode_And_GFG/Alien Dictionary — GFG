class Solution {
    public String findOrder(String[] words) {
        // code here
        List<List<Integer>> adj = new ArrayList<>();
        Queue<Integer> q = new LinkedList<>();
        int[] indegree = new int[26];

        for(int i=0; i<26; i++) adj.add(new ArrayList<>());
        Arrays.fill(indegree, -1);


        for(String word : words){
            for(char ch : word.toCharArray()){
                indegree[ch-'a']=0;
            }
        }

        for(int i=1; i<words.length; i++){
            String w1 = words[i-1];
            String w2 = words[i];

            int len1 = w1.length();
            int len2 = w2.length();
            int j=0;

            while(j<len1 && j<len2 && w1.charAt(j)==w2.charAt(j) ){
                j++;
            }

            if(j==len2 && j<len1) return "";

            if(j<len1 && j<len2) {
                int u = w1.charAt(j) - 'a';
                int v = w2.charAt(j) - 'a';

                adj.get(u).add(v);
                indegree[v]++;
            }
        }

        int total = 0;
        for(int i=0; i<26; i++){
            if(indegree[i]==0) q.offer(i);
            if(indegree[i]!=-1) total++;
        }

        StringBuilder ans = new StringBuilder();
        while(!q.isEmpty()){
            int node = q.poll();
            ans.append((char)('a' + node));
            indegree[node]--;

            for(int i : adj.get(node)){
                indegree[i]--;
                if(indegree[i]==0){
                    q.offer(i);
                }
            }
        }
        // System.out.println(ans);
        return total==ans.length() ? ans.toString() : "";
    }
}