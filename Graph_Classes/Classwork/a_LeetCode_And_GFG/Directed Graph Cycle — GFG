class Solution {

    public boolean isCyclic(int V, int[][] edges) {
        // code here
        List<List<Integer>> adj = new ArrayList<>();
        int[] indegree = new int[V];
        Queue<Integer> q = new LinkedList<>();

        for(int i=0; i<V; i++){
            adj.add(new ArrayList<>());
        }

        for(int[] edge : edges){
            int u = edge[0];
            int v = edge[1];
            adj.get(u).add(v);
            indegree[v]++;
        }

        for(int i=0; i<V; i++){
            if(indegree[i]==0){
                q.offer(i);
            }
        }

        int count = 0;
        while(!q.isEmpty()){

            int node = q.poll();
            indegree[node]--;
            count++;

            for(int i : adj.get(node)){
                indegree[i]--;
                if(indegree[i]==0) q.offer(i);
            }

        }

        return count!=V;

    }
}
