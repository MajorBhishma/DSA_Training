class Solution {
    int[] dx = {-1,1,0,0};
    int[] dy = {0,0,-1,1};
    int n,m,len;

    public boolean exist(char[][] board, String word) {
        m = board.length;
        n = board[0].length;
        len = word.length();
        char ch = word.charAt(0);

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(board[i][j]==ch){
                    if(DFS(board, word, i, j, 1)) return true;
                }
            }
        }
        return false;
    }

    boolean DFS(char[][] board, String word, int sr, int sc, int index){
        if(index==len) return true;

        board[sr][sc] = '.';

        for(int k=0; k<4; k++){
            int nx = sr + dx[k];
            int ny = sc + dy[k];

            if(nx>=0 && nx<m && ny>=0 && ny<n && board[nx][ny]==word.charAt(index)){
                if(DFS(board, word, nx, ny, index+1)) return true;
            }
        }

        board[sr][sc]=word.charAt(index-1);
        return false;
    }
}