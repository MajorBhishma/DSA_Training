class Solution {
    int n;
    public boolean isBipartite(int[][] graph) {
        n = graph.length;
        int[] colorArr = new int[n];
        Arrays.fill(colorArr, -1);

        for(int i=0; i<n; i++){
            if(colorArr[i]==-1){

                if(!BFS(graph, i, colorArr)) return false;
            }
        }

        return true;
    }

    boolean BFS(int[][] graph, int start, int[] colorArr){
        Queue<Integer> q = new LinkedList<>();
        q.offer(start);
        colorArr[start]=0;

        while(!q.isEmpty()){
            int node = q.poll();
            int color = colorArr[node];

            for(int i : graph[node]){
                if(colorArr[i]==-1){
                    colorArr[i]=1-color;
                    q.offer(i);
                }
                else if(colorArr[i]==color){
                    return false;
                }
            }
        }
        return true;
    }
}