class Solution {
    Queue<Integer> q = new LinkedList<>();
    boolean[] visited;

    public int longestCycle(int[] edges) {
        int n = edges.length;
        int[] indegree = new int[n];
        int ans=0;
        visited = new boolean[n];

        for(int i : edges){
            if(i!=-1)
                indegree[i]++;
        }

        for(int i=0; i<n; i++){
            if(indegree[i]==0){
                q.offer(i);
                visited[i]=true;
            }
        }

        while(!q.isEmpty()){
            int node = q.poll();
            indegree[node]--;

            int v = edges[node];
            if(v!=-1){
                indegree[v]--;
                if(indegree[v]==0){
                    q.offer(v);
                    visited[v] = true;
                }
            }
        }

        for(int i=0; i<n; i++){
            if(!visited[i]){
                ans = Math.max(ans, BFS(i, edges));
            }
        }

        return ans==0 ? -1 : ans;
    }

    int BFS(int start, int[] edges){

        q.offer(start);
        visited[start]=true;
        int count = 0;

        while(!q.isEmpty()){
            int node = q.poll();
            count++;

            int i = edges[node];
            if (i!=-1) {
                if(!visited[i]){
                    q.offer(i);
                    visited[i]=true;
                }
            }
        }
        return count;
    }
}