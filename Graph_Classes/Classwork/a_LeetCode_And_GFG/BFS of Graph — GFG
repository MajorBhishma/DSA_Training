class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {

        int start = 0, n = adj.size();
        Queue<Integer> q = new LinkedList<>();
        boolean[] visited = new boolean[n];
        ArrayList<Integer> ans = new ArrayList<>();
        q.offer(start);
        visited[start]=true;
        while(!q.isEmpty()){
            int node = q.poll();
            ans.add(node);
            for(int i : adj.get(node)){
                if(!visited[i]){
                    q.offer(i);
                    visited[i]=true;
                }
            }
        }
        return ans;
    }
}