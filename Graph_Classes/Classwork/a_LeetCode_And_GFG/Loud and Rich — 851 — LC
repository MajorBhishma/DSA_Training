class Solution {

    int dfs(int u, int[] ans, List<List<Integer>> adj, int[] quiet){
        if(ans[u]!=-1) return ans[u];
        int leastQuiet = u;

        for(int v : adj.get(u)){
            int temp = dfs(v, ans, adj, quiet);
            if(quiet[temp] < quiet[leastQuiet]){
                leastQuiet = temp;
            }
        }
        return ans[u] = leastQuiet;
    }
    public int[] loudAndRich(int[][] richer, int[] quiet) {
        int n = quiet.length;
        int[] ans = new int[n];
        List<List<Integer>> adj = new ArrayList<>();

        Arrays.fill(ans, -1);
        for(int i=0; i<n; i++)adj.add(new ArrayList<>());

        for(int[] i : richer){
            adj.get(i[1]).add(i[0]);
        }

        for(int i=0; i<n; i++){
            if(ans[i]==-1){
                dfs(i, ans, adj, quiet);
            }
        }

        return ans;
    }

}