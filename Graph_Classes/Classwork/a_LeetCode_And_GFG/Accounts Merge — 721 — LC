class Solution {

    void BFS(int start, boolean[] visited, List<List<String>> ans, List<List<Integer>> adj, List<List<String>> accounts){
        ans.add(new ArrayList());
        ans.getLast().add(accounts.get(start).get(0));

        Queue<Integer> q = new ArrayDeque<>();
        q.offer(start);
        visited[start] = true;
        Set<String> set = new HashSet<>();

        while(!q.isEmpty()){
            int node = q.poll();
            List<String> temp = accounts.get(node);
            for(int i=1; i<temp.size(); i++){
                set.add(temp.get(i));
            }

            for(int i : adj.get(node)){
                if(!visited[i]){
                    q.offer(i);
                    visited[i]=true;
                }
            }
        }
        List<String> temp = new ArrayList<>(set);
        Collections.sort(temp);
        ans.getLast().addAll(temp);
    }
    public List<List<String>> accountsMerge(List<List<String>> accounts) {
        int n = accounts.size();
        Map<String, Integer> parent = new HashMap<>();
        List<List<Integer>> adj = new ArrayList<>();

        for(int i=0; i<n; i++){
            adj.add(new ArrayList<>());
            int len = accounts.get(i).size();

            for(int j=1; j<len; j++){
                String mail = accounts.get(i).get(j);
                if(parent.get(mail)!=null){
                    int p = parent.get(mail);
                    adj.get(i).add(p);
                    adj.get(p).add(i);
                }
                else{
                    parent.put(mail, i);
                }
            }
        }

        boolean[] visited = new boolean[n];
        List<List<String>> ans = new ArrayList<>();
        for(int i=0; i<n; i++){
            if(!visited[i]){
                BFS(i, visited, ans, adj, accounts);
            }
        }
        return ans;
    }
}