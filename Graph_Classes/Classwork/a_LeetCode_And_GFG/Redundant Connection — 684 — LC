class Solution {
    int[] parent;
    int[] size;

    int findParent(int x){
        int p = parent[x];

        if(p==x) return p;

        return parent[x]=findParent(p);
    }
    boolean union(int x, int y){
        int px = findParent(x);
        int py = findParent(y);

        if(px==py) return true;

        if(size[px]>size[py]){
            size[px]+=size[py];
            parent[py]=px;
        }

        else{
            size[py]+=size[px];
            parent[px]=py;
        }
        return false;
    }

    public int[] findRedundantConnection(int[][] edges) {
        int n = edges.length;
        parent = new int[n+1];
        size = new int[n+1];

        for(int i=0; i<=n; i++){
            parent[i]=i;
        }
        Arrays.fill(size, 1);

        for(int[] i : edges){
            int u = i[0];
            int v = i[1];

            if(union(u,v)) return i;
        }
    return new int[]{};
    }

}