class Solution {
    public boolean possibleBipartition(int n, int[][] dislikes) {
        List<List<Integer>> dislike = new ArrayList<>();
        int[] colorArr = new int[n+1];

        Arrays.fill(colorArr,-1);
        for(int i=0; i<=n; i++) dislike.add(new ArrayList<>());

        for(int[] i : dislikes){
            int u = i[0];
            int v = i[1];
            dislike.get(u).add(v);
            dislike.get(v).add(u);
        }


        for(int i=1; i<=n; i++){
            if(colorArr[i]==-1){
                if( !BFS(dislike, i, colorArr) ) return false;
            }
        }
        return true;
    }

    boolean BFS(List<List<Integer>> dislike, int start, int[] colorArr){
        Queue<Integer> q = new LinkedList<>();
        q.offer(start);
        colorArr[start]=0;

        while(!q.isEmpty()){
            int node = q.poll();
            int color = colorArr[node];

            for(int i : dislike.get(node)){
                if(colorArr[i]==-1){
                    q.offer(i);
                    colorArr[i] = 1-color;
                }
                else{
                    if(colorArr[i]!=1-color) return false;
                }
            }
        }
        return true;
    }
}